# ---------------------------------------------------------------------------
# FARMDirect – server configuration
# Copy to .env and fill in. Every external service is optional: when a key is
# missing the related feature shows a "not configured" state instead of fake data.
# ---------------------------------------------------------------------------

# Core ----------------------------------------------------------------------
NODE_ENV=development
PORT=3001
# REQUIRED in production: long random string. Signs verification codes and hashes IPs.
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
APP_SECRET=
# SQLite database file and private upload directory (use a persistent disk in production)
DATABASE_FILE=./data/farmdirect.db
UPLOAD_DIR=./data/uploads
SESSION_DAYS=30
# Set to false to disable background jobs (reminders, forecast alerts, price watch, cleanup)
ENABLE_JOBS=true
# Prototype deployments only: "on" shows one-time codes on screen when no SMS provider is
# set and loads demo accounts. Anyone who knows a phone number can then sign in.
DEMO_MODE=off

# First super administrator (created on startup if the number does not exist yet).
# Alternatively: npm run create-admin -- <phone> <password> "<name>"
SUPER_ADMIN_PHONE=
SUPER_ADMIN_PASSWORD=
SUPER_ADMIN_NAME=Super Admin

# AI – Crop Doctor image diagnosis and Medha AI assistant (Google Gemini) ----
# Key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
GEMINI_FALLBACK_MODEL=gemini-flash-lite-latest

# Weather – Open-Meteo ---------------------------------------------------------
# Works without a key for NON-COMMERCIAL use. Commercial deployments must buy a key.
OPEN_METEO_API_KEY=
WEATHER_CACHE_MINUTES=30

# Mandi prices – Agmarknet via Open Government Data Platform (data.gov.in) -----
# Free key: register at https://data.gov.in → My Account → API key
DATA_GOV_IN_API_KEY=
AGMARKNET_RESOURCE_ID=9ef84268-d588-465a-a308-a864a43d0070
MANDI_CACHE_MINUTES=60

# SMS / OTP --------------------------------------------------------------------
# Without a provider: development prints OTPs to the server console and shows them
# on screen; production refuses to send OTPs. Choose msg91 (DLT-registered template
# required in India) or twilio.
SMS_PROVIDER=
MSG91_AUTH_KEY=
MSG91_OTP_TEMPLATE_ID=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# Administrator security -------------------------------------------------------
# Administrators sign in with password + one-time code. In production the code is sent
# by SMS, so an SMS provider is REQUIRED for admin sign-in. Set to "off" only for an
# isolated local machine.
ADMIN_MFA=on

# Aadhaar QR auto-fill -----------------------------------------------------------
# Optional: UIDAI public certificate (PEM text or a file path) used to check the digital
# signature of Aadhaar Secure QR codes. Without it, details are still filled in but the
# farmer is asked to check them, and the identity level is not raised.
UIDAI_QR_CERT=

# Online payments – Razorpay (optional) ---------------------------------------------
# Without these keys, payments are recorded by the payer and confirmed by the recipient
# (no money moves through FARMDirect, and no escrow is offered).
# Webhook URL to configure in the Razorpay dashboard: https://<your-domain>/api/webhooks/razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Satellite NDVI – Sentinel Hub (Copernicus Sentinel-2 L2A) ----------------------
# OAuth client from https://www.sentinel-hub.com/ dashboard
SENTINELHUB_CLIENT_ID=
SENTINELHUB_CLIENT_SECRET=
